{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.aggregate.finance"
        }
      ],
      "destination": "https://app.aggregate.finance/docs/guides",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "docs.aggregate.finance"
        }
      ],
      "destination": "https://app.aggregate.finance/docs/:path*",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.aggregate.finance"
        }
      ],
      "destination": "https://aggregate.finance/$1",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/security",
      "destination": "https://app.aggregate.finance/security",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
