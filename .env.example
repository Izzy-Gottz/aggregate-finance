# Copy to .env (never commit it). Generate secrets with: npm run -s keygen >> .env
BASE_URL=http://localhost:8787
# Hosted: BASE_URL=https://app.aggregate.finance
# Another port: change PORT and BASE_URL together (sign-in links and redirect URIs use BASE_URL)
PORT=8787
# sqlite:/absolute/path.db (default ./data/agfn.db) or postgres://user:pass@host/db
# DATABASE_URL=
DATA_DIR=./data
# 32+ random characters; signs sessions
AUTH_SECRET=
# Master encryption key for provider secrets. Keep it OUTSIDE DATA_DIR and out of backups.
AGFN_MASTER_KEY=
# AGFN_MASTER_KEY_FILE=/run/secrets/meridn_master_key
# AGFN_MASTER_KEY_COMMAND=aws kms decrypt --ciphertext-blob fileb:///etc/agfn/master.enc --query Plaintext --output text
# (set exactly one of AGFN_MASTER_KEY, AGFN_MASTER_KEY_FILE, AGFN_MASTER_KEY_COMMAND; see docs/self-hosting.md)
# Email for sign-in links (without it, links print to the server console)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Resend: SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:465
# MAIL_FROM=Aggregate <no-reply@example.com>
# Optional sign-in providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# Connectors (each appears only when its keys are set)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# AGFN_HIDE_CONNECTORS=plaid   (optional: pause NEW connections to these connectors; existing ones keep syncing)
# OAuth apps: register the redirect URI ${BASE_URL}/api/connectors/<key>/callback in each developer console,
# e.g. https://app.aggregate.finance/api/connectors/quickbooks/callback (or http://localhost:8787/... for dev)
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENV=sandbox   (sandbox unless set to production)
# QUICKBOOKS_WEBHOOK_VERIFIER=   (optional; change notices at ${BASE_URL}/api/webhooks/quickbooks)
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_SCOPES=   (optional; default is the granular read scopes new Xero apps get. Apps from before 2026-03-02:
#   openid offline_access accounting.settings.read accounting.transactions.read accounting.contacts.read accounting.reports.read)
# XERO_WEBHOOK_KEY=   (optional; change notices at ${BASE_URL}/api/webhooks/xero, the signing key from Xero's Webhooks page)
# FRESHBOOKS_CLIENT_ID=
# FRESHBOOKS_CLIENT_SECRET=
# AGFN_OFFER_FRESHBOOKS=1   (hosted only: offer it on live, after a real account has connected)
# FINCH_CLIENT_ID=
# FINCH_CLIENT_SECRET=
# FINCH_SANDBOX=1   (Finch's test payroll systems)
# JUSTWORKS_CLIENT_ID=
# JUSTWORKS_CLIENT_SECRET=
# CARTA_CLIENT_ID=   (Carta developer portal app; redirect ${BASE_URL}/api/connectors/carta/callback; read_portfolio_* scopes)
# CARTA_CLIENT_SECRET=
# CARTA_ENV=playground   (Carta's playground and its test personas; production once Carta approves the app)
# WEFUNDER_CLIENT_ID=   (wefunder.com/developers app; read:investments; redirect ${BASE_URL}/api/connectors/wefunder/callback; pk_test_ = sandbox realm)
# WEFUNDER_CLIENT_SECRET=
# WEFUNDER_APPROVED=1   (hosted: offer Wefunder once Wefunder approves the app for other people's accounts)
# COINBASE_CLIENT_ID=   (Coinbase Developer Platform OAuth client, approved partners only for now; redirect ${BASE_URL}/api/connectors/coinbase/callback)
# COINBASE_CLIENT_SECRET=   (without both, self-hosters paste a View-only CDP API key; hosted shows no Coinbase)
# AGFN_OFFER_COINBASE=1   (hosted: offer Coinbase sign-in once a real connect passed on staging)
# HARVEST_CLIENT_ID=   (Aggregate's Harvest OAuth app: Harvest ID → Developers → Create new OAuth2 application; redirect ${BASE_URL}/api/connectors/harvest/callback)
# HARVEST_CLIENT_SECRET=   (Harvest has no read-only scope, so the client refuses anything but GET; without both, self-hosters paste a personal access token; hosted shows no Harvest)
# AGFN_OFFER_HARVEST=1   (hosted: offer Harvest sign-in once a real connect passed on staging)
# LIGHTSPEED_CLIENT_ID=   (Aggregate's Lightspeed Retail X-Series app: developers.retail.lightspeed.app; redirect ${BASE_URL}/api/connectors/lightspeed/callback)
# LIGHTSPEED_CLIENT_SECRET=   (sign-in asks only sales:read, retailer:read, payment_types:read; without both, self-hosters paste a personal token and domain prefix; hosted shows no Lightspeed)
# AGFN_OFFER_LIGHTSPEED=1   (hosted: offer Lightspeed sign-in once a real connect passed on staging)
# SUMUP_CLIENT_ID=   (Aggregate's SumUp OAuth app: me.sumup.com → Settings → For Developers → OAuth apps; redirect ${BASE_URL}/api/connectors/sumup/callback)
# SUMUP_CLIENT_SECRET=   (sign-in asks only transactions.history + user.profile_readonly; without both, self-hosters paste an API key, which has full access, so the client refuses anything but GET; hosted shows no SumUp)
# AGFN_OFFER_SUMUP=1   (hosted: offer SumUp sign-in once a real connect passed on staging)
# ADSENSE_CLIENT_ID=   (Aggregate's Google OAuth app, AdSense Management API; redirect ${BASE_URL}/api/connectors/adsense/callback)
# ADSENSE_CLIENT_SECRET=   (sign-in asks only adsense.readonly; without both there's no AdSense connector)
# MOLLIE_CLIENT_ID=   (Aggregate's Mollie OAuth app, app_…; scopes balances.read and balance-reports.read only; redirect ${BASE_URL}/api/connectors/mollie/callback)
# MOLLIE_CLIENT_SECRET=   (sign-in refuses any other grant; without both there's no Mollie connector)
# AGFN_OFFER_MOLLIE=1   (hosted: offer Mollie once a real connect passed and the package README's checks are done)
# WHOP_CLIENT_ID=   (Aggregate's Whop OAuth app, app_…; scope company:balance:read only; redirect ${BASE_URL}/api/connectors/whop/callback)
# WHOP_CLIENT_SECRET=   (sign-in refuses any wider grant; without both there's no Whop connector)
# AGFN_OFFER_WHOP=1   (hosted: offer Whop once a real connect passed and the package README's checks are done)
# OWNERREZ_CLIENT_ID=   (Aggregate's OwnerRez OAuth app, default scope Read; redirect ${BASE_URL}/api/connectors/ownerrez/callback)
# OWNERREZ_CLIENT_SECRET=   (sign-in asks only the read scope and refuses any other grant; without both there's no OwnerRez connector)
# AGFN_OFFER_OWNERREZ=1   (hosted: offer OwnerRez once a real connect passed and the package README's checks are done)
# BIGCOMMERCE_CLIENT_ID=   (Aggregate's BigCommerce single-click app; auth callback ${BASE_URL}/api/connectors/bigcommerce/auth,
#   load /load, uninstall /uninstall, remove user /remove_user, all under /api/connectors/bigcommerce)
# BIGCOMMERCE_CLIENT_SECRET=   (scopes: Orders and Information & Settings, read-only; without both, only the pasted token works)
# SQUARESPACE_CLIENT_ID=   (Aggregate's Squarespace OAuth app; redirect ${BASE_URL}/api/connectors/squarespace/callback)
# SQUARESPACE_CLIENT_SECRET=   (sign-in asks only website.transactions.read; without both there's no Squarespace connector)
# AGFN_OFFER_SQUARESPACE=1   (hosted: offer Squarespace once a real connect passed and the package README's checks are done)
# WIX_CLIENT_ID=   (Aggregate's Wix app; app ID. Install redirect ${BASE_URL}/api/connectors/wix/callback)
# WIX_CLIENT_SECRET=   (the app secret; the app's only permission is Read Orders, set in Wix's dashboard; without both there's no Wix connector)
# WIX_SHARE_URL_ID=   (unlisted app only: Wix's Share URL id, testing only, 80 installs at most)
# AGFN_OFFER_WIX=1   (hosted: offer Wix once a real connect passed and the package README's checks are done)
# AGFN_OFFER_BIGCOMMERCE=1   (hosted: offer BigCommerce, a pasted read-only store token, once a real connect passed and the package README's checks are done)
# AMAZON_SPAPI_APP_ID=   (Aggregate's registered Selling Partner API app, not secret: amzn1.sellerapps.app.…; Finance and Accounting role only)
# AMAZON_SPAPI_CLIENT_ID=   (the app's Login with Amazon client id; redirect ${BASE_URL}/api/connectors/amazon/callback, log-in URI ${BASE_URL}/api/connectors/amazon/login)
# AMAZON_SPAPI_CLIENT_SECRET=   (the LWA client secret; without all three there's no Amazon connector)
# AMAZON_SPAPI_DRAFT=0   (set once the app is published; until then sign-in carries version=beta, which only a Draft app's own test sellers can use)
# AMAZON_SPAPI_SANDBOX_CLIENT_ID= / _CLIENT_SECRET= / _REFRESH_TOKEN=   (staging only: a Sandbox app for the static-sandbox probe, packages/connectors/amazon/README.md; never on live)
# AGFN_OFFER_AMAZON=1   (hosted: offer Amazon once a real Draft self-authorization test passed and the package README's checks are done)
# ETSY_CLIENT_ID=   (Aggregate's Etsy app keystring, the OAuth client id; redirect ${BASE_URL}/api/connectors/etsy/callback; sign-in asks transactions_r shops_r only)
# ETSY_CLIENT_SECRET=   (the app's shared secret: every API call sends keystring:shared_secret as x-api-key; without both there's no Etsy connector)
# AGFN_OFFER_ETSY=1   (hosted: offer Etsy once a real shop synced cleanly and the package README's checks are done)
# YOUTUBE_CLIENT_ID=   (Aggregate's Google OAuth app, YouTube Data and Analytics APIs; redirect ${BASE_URL}/api/connectors/youtube/callback)
# YOUTUBE_CLIENT_SECRET=   (sign-in asks only youtube.readonly and yt-analytics-monetary.readonly; without both there's no YouTube connector)
# AGFN_OFFER_YOUTUBE=1   (hosted: offer YouTube once a real connect passed on staging and the package README's list is done)
# PINTEREST_CLIENT_ID=   (Aggregate's Pinterest app; redirect ${BASE_URL}/api/connectors/pinterest/callback)
# PINTEREST_CLIENT_SECRET=   (sign-in asks only ads:read; without both there's no Pinterest connector)
# AGFN_OFFER_PINTEREST=1   (hosted: offer Pinterest once a real connect passed on staging and the package README's list is done)
# AGFN_OFFER_ADSENSE=1   (hosted: offer AdSense once a real connect passed on staging and the package README's terms check is done)
# GUMROAD_CLIENT_ID=   (Aggregate's Gumroad OAuth app: Gumroad Settings → Advanced → Applications; redirect ${BASE_URL}/api/connectors/gumroad/callback)
# GUMROAD_CLIENT_SECRET=   (sign-in asks only view_sales + view_payouts; without both, self-hosters paste a generated token, which has full access; hosted shows no Gumroad)
# AGFN_OFFER_GUMROAD=1   (hosted: offer Gumroad sign-in once a real connect passed on staging)
# PATREON_CLIENT_ID=   (Aggregate's Patreon client: patreon.com/portal/registration/register-clients, API version 2; redirect ${BASE_URL}/api/connectors/patreon/callback)
# PATREON_CLIENT_SECRET=   (sign-in asks only identity, campaigns, campaigns.members; without both, self-hosters paste a Creator's Access Token; hosted shows no Patreon)
# AGFN_OFFER_PATREON=1   (hosted: offer Patreon sign-in once a real connect passed on staging)
# Stripe, Square, Mercury, Brex, Ramp, Wise, PayPal, Paddle, Lemon Squeezy, App Store and Google Play need nothing here:
# each person pastes a read-only key when connecting (test-mode keys work: Stripe rk_test_/sk_test_, a Square
# sandbox access token). The variables below only add one-click sign-in with an app of your own:
# SQUARE_CLIENT_ID=
# SQUARE_CLIENT_SECRET=
# SQUARE_ENV=sandbox   (production unless set; a pasted token works in either)
# STRIPE_APP_CLIENT_ID=   (a Stripe App; also STRIPE_APP_SECRET_KEY_LIVE / STRIPE_APP_SECRET_KEY_TEST)
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# MERCURY_CLIENT_ID= / BREX_CLIENT_ID= / RAMP_CLIENT_ID= / PAYPAL_CLIENT_ID= (each with its _CLIENT_SECRET; partner apps)
# Deel, BILL and Rippling use each company's own pasted keys (always offered). Default environment in the form:
# DEEL_ENV=sandbox
# Deel one-click sign-in instead: your Deel app (Settings > Developer > Apps, redirect <BASE_URL>/api/connectors/deel/callback).
# DEEL_CLIENT_ID=
# DEEL_CLIENT_SECRET=   (DEEL_ENV=sandbox when the app was made in Deel's sandbox, app.demo.deel.com)
# Polar: each person pastes an organization access token with read scopes. One-click sign-in instead: your Polar OAuth
# app (polar.sh → Settings → Developers → OAuth applications, redirect <BASE_URL>/api/connectors/polar/callback).
# POLAR_CLIENT_ID=
# POLAR_CLIENT_SECRET=   (POLAR_ENV=sandbox when the app was made on sandbox.polar.sh)
# SimpleFIN Bridge needs no keys (each person pastes a Setup Token). Self-hosters with their own SimpleFIN server:
# SIMPLEFIN_ALLOW_ANY_HOST=1
# BILL_ENV=sandbox
# BILL's app-partner developer keys (from developerprogram@hq.bill.com): with one, BILL connect asks for an AP/AR sync
# token and organization ID instead of each company's own developer key. BILL_DEV_KEY is production, or sandbox when
# BILL_ENV=sandbox and BILL_SANDBOX_DEV_KEY is unset; hosted offers BILL only when one of these is set.
# BILL_DEV_KEY=
# BILL_SANDBOX_DEV_KEY=
SYNC_EVERY_MINUTES=60
# all | web | worker
AGFN_ROLE=all

# Hosted file storage (S3, Cloudflare R2 or MinIO). Unset = files on the data volume.
# FILES_S3_BUCKET=agfn-files
# FILES_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# FILES_S3_REGION=auto
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_PREFIX=prod/
# Nightly encrypted backup (keeps 30 days; restore with `agfn backup restore`). Use a separate bucket and keys.
# BACKUP_S3_BUCKET=agfn-backups
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# Email-in: the domain inbound addresses use, and the secret your email provider sends with each webhook
# (Postmark: put it in the webhook URL's basic auth; a Cloudflare Email Worker: send it as x-agfn-inbound-secret).
# INBOUND_EMAIL_DOMAIN=in.example.com
# INBOUND_WEBHOOK_SECRET=
# Email-in through Resend (docs/email-in.md): webhook signing secret + an API key that can read received emails
# RESEND_WEBHOOK_SECRET=whsec_
# RESEND_API_KEY=re_

# Operator alerts (sync and job failures) to a Slack/Discord/ntfy-style webhook that accepts {"text": "..."}.
# ALERT_WEBHOOK_URL=
# Demo keys for directory health checks (sha256 hex of each agfn_demo_… key, comma separated; needs AGFN_PUBLIC_DEMO=1)
# AGFN_PUBLIC_DEMO_KEYS=
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# Header your proxy sets to the real client IP (used for rate limits). Fly.io is detected automatically.
# Behind Cloudflare: cf-connecting-ip. Caddy (deploy/aws/Caddyfile overwrites it with the peer): x-real-ip.
# Never x-forwarded-for. Hosted (AGFN_HOSTED=1) refuses to start off Fly without it.
# CLIENT_IP_HEADER=

# The job queue's release id (packages/db/src/jobs.ts release guard): during a deploy's overlap only the newest
# release's worker claims jobs. Fly's FLY_IMAGE_REF is used automatically; anywhere else set a fresh value per deploy
# (scripts/deploy-aws.sh does). Hosted (AGFN_HOSTED=1) refuses to start a worker without one.
# AGFN_RELEASE=

# In-app intrusion detection per client IP (apps/server/src/intrusion.ts): scanner paths, failed sign-ins, rate-limit
# trips. detect (default) alerts the operator; block also answers that IP with a 429 for 15 minutes; off skips it.
# AGFN_INTRUSION=detect

# Reviewer access links for app-directory reviews (apps/server/src/reviewer.ts). Off unless set to 1, here and wherever
# `agfn reviewer-link create` runs. Each link signs a reviewer into a demo-only account; demo books rebuild nightly.
# AGFN_REVIEWER_LINKS=1
